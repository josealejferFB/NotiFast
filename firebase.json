{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "landing",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/docs",
        "destination": "/docs.html"
      },
      {
        "source": "/docs/**",
        "destination": "/docs.html"
      }
    ]
  }
}
