# Cloudflare Pages Redirects & Fallbacks
# Format: /source /destination [status]

# Redirect .html to clean /docs URL
/docs.html /docs 301

# SPA routing for docs sub-routes
/docs/* /docs 200

# Redirect .html to clean /privacy URL
/privacy.html /privacy 301

# SPA routing for privacy sub-routes
/privacy/* /privacy 200

# Fallback 404
/* /404.html 404
